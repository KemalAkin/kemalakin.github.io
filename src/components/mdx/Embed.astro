---
// Responsive iframe for YouTube recordings (privacy-enhanced domain) or other embeds such as Tableau.
interface Props {
  youtube?: string;
  src?: string;
  title: string;
  ratio?: string;
}
const { youtube, src, title, ratio = "16 / 9" } = Astro.props;
const url = youtube ? `https://www.youtube-nocookie.com/embed/${youtube}` : src;
---

<div class="embed" style={`aspect-ratio:${ratio}`}>
  <iframe
    src={url}
    title={title}
    loading="lazy"
    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen
    referrerpolicy="strict-origin-when-cross-origin"></iframe>
</div>

<style>
  .embed { position: relative; width: 100%; max-width: none; margin: 20px 0 28px; border-radius: 12px; overflow: hidden; border: 1px solid var(--line); background: var(--sunken); }
  .embed iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>
