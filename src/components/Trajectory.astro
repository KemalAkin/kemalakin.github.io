---
// Career as a trajectory: one line from physics to data science, drawn when it scrolls into view.
// Horizontal from 760px up, vertical on phones.
const stops = [
  { when: "2013–2022", title: "Physics, İTÜ", sub: "B.Sc. & M.Sc. Physics Engineering, cosmology" },
  { when: "2019–2021", title: "Forensic science", sub: "Research assistant, Üsküdar University" },
  { when: "2021–2022", title: "Trading", sub: "Derivatives markets, self-employed" },
  { when: "Now", title: "Data science", sub: "Financial data, crypto markets", now: true },
];
---

<section class="wrap traj-wrap" aria-label="Trajectory">
  <ol class="traj" data-traj>
    {stops.map((s, i) => (
      <li class:list={[{ now: s.now }]} style={`--i:${i}`}>
        <span class="dot" aria-hidden="true"></span>
        <span class="label">{s.when}</span>
        <span class="t">{s.title}</span>
        <span class="s">{s.sub}</span>
      </li>
    ))}
  </ol>
</section>

<script>
  document.addEventListener("astro:page-load", () => {
    const el = document.querySelector<HTMLElement>("[data-traj]");
    if (!el) return;
    if (!("IntersectionObserver" in window)) { el.classList.add("in"); return; }
    const io = new IntersectionObserver((es) => {
      if (es[0].isIntersecting) { el.classList.add("in"); io.disconnect(); }
    }, { threshold: 0.4 });
    io.observe(el);
  });
</script>

<style>
  .traj-wrap { padding-block: 8px 24px; }
  .traj {
    --dot: 11px;
    --rail: linear-gradient(90deg, var(--accent), var(--warm));
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
    padding-left: 28px;
  }
  /* the rail */
  .traj::before {
    content: "";
    position: absolute;
    left: 5px; top: 6px; bottom: 6px;
    width: 1.5px;
    background: linear-gradient(180deg, var(--accent), var(--warm));
    transform-origin: top;
    transform: scaleY(0);
    transition: transform 1.1s cubic-bezier(.3,.7,.2,1);
  }
  .traj.in::before { transform: none; }
  li { position: relative; display: grid; gap: 2px; min-width: 0; opacity: 0.25; transform: translateY(6px); transition: opacity 0.5s ease, transform 0.5s ease; transition-delay: calc(var(--i) * 0.22s + 0.15s); }
  .traj.in li { opacity: 1; transform: none; }
  .dot {
    position: absolute;
    left: calc(-28px + 5.75px - var(--dot) / 2);
    top: 3px;
    width: var(--dot); height: var(--dot);
    border-radius: 50%;
    background: var(--bg);
    border: 1.5px solid var(--accent);
  }
  li:nth-child(2) .dot { border-color: color-mix(in srgb, var(--accent) 66%, var(--warm)); }
  li:nth-child(3) .dot { border-color: color-mix(in srgb, var(--accent) 33%, var(--warm)); }
  .now .dot { background: var(--warm); border-color: var(--warm); box-shadow: 0 0 0 4px var(--warm-soft); }
  @media (prefers-reduced-motion: no-preference) {
    .traj.in .now .dot { animation: pulse 2.4s ease-in-out 1.4s infinite; }
  }
  @keyframes pulse { 50% { box-shadow: 0 0 0 7px transparent; } }
  .t { font-family: var(--f-display); font-size: 1.3rem; line-height: 1.2; }
  .s { color: var(--muted); font-size: 0.9rem; }
  .now .label { color: var(--warm); }

  @media (min-width: 760px) {
    .traj { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; padding-left: 0; padding-top: 30px; }
    .traj::before {
      left: 0; right: 0; top: 5px; bottom: auto;
      width: auto; height: 1.5px;
      background: var(--rail);
      transform-origin: left;
      transform: scaleX(0);
    }
    .dot { left: 0; top: calc(-30px + 5.75px - var(--dot) / 2); }
  }

  @media (prefers-reduced-motion: reduce) {
    .traj::before { transform: none !important; }
    li { opacity: 1; transform: none; }
  }
</style>
