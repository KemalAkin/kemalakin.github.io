---
// Drop once on any page that renders WorkCard thumbnails.
---

<script>
  import { initThumbs } from "../scripts/thumbs";

  let cleanup: (() => void) | null = null;
  document.addEventListener("astro:page-load", () => {
    cleanup?.();
    cleanup = document.querySelector("canvas[data-thumb]") ? initThumbs() : null;
  });
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
  });
</script>
